# Salin menjadi .env, atau jalankan `npm run setup` untuk membuatnya otomatis.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/primecaps"
BETTER_AUTH_URL="http://127.0.0.1:3030"
# Nilai acak minimal 32 karakter, misalnya hasil `openssl rand -hex 32`.
BETTER_AUTH_SECRET=""
# Opsional. Kata sandi akun demo saat seeding; wajib diganti untuk instance yang di-deploy.
DEMO_PASSWORD=""
# Opsional. Alamat layanan model FastAPI (tanpa /v1/predict). Kosong = memakai model tiruan untuk uji tampilan.
PREDICTION_API_URL=""
# Opsional. Token yang dikirim sebagai "Authorization: Bearer ..." ke layanan model.
PREDICTION_API_KEY=""
# Database khusus tes otomatis (npm test). Isinya dihapus setiap kali tes berjalan, jangan pakai database utama.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/primecaps_test"
