generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  role          UserRole     @default(STUDENT)
  active        Boolean      @default(true)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  teaching      Course[]     @relation("CourseTeacher")
  enrollments   Enrollment[]
  submissions   Submission[]
  completions   MaterialCompletion[]
  followUps     FollowUp[]          @relation("FollowUpStudent")
  followUpsMade FollowUp[]          @relation("FollowUpTeacher")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  teacherId   String
  teacher     User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  assignments Assignment[]
  materials   Material[]
  followUps   FollowUp[]

  @@index([teacherId])
}

model Enrollment {
  courseId  String
  studentId String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@index([studentId])
}

model Assignment {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  createdAt    DateTime     @default(now())
  submissions  Submission[]

  @@index([courseId, createdAt])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer       String
  submittedAt  DateTime   @default(now())
  score        Int?
  feedback     String?
  files        Attachment[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Material {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  createdAt   DateTime     @default(now())
  files       Attachment[]
  // Materi asal bila materi ini hasil pakai ulang dari kelas lain.
  sourceId    String?
  source      Material?    @relation("MaterialReuse", fields: [sourceId], references: [id], onDelete: SetNull)
  copies      Material[]   @relation("MaterialReuse")
  completions MaterialCompletion[]

  @@index([courseId, createdAt])
}

// Penyelesaian materi berupa konfirmasi mandiri peserta.
model MaterialCompletion {
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([materialId, studentId])
  @@index([studentId])
}

enum FollowUpStatus {
  OPEN
  DONE
}

model FollowUp {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User           @relation("FollowUpStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User           @relation("FollowUpTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  note      String
  status    FollowUpStatus @default(OPEN)
  createdAt DateTime       @default(now())

  @@index([courseId, studentId, createdAt])
}

model Attachment {
  id           String      @id @default(cuid())
  filename     String
  size         Int
  content      Bytes
  materialId   String?
  material     Material?   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([submissionId])
}
